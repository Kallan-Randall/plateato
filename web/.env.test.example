# Credentials for a dedicated, disposable test account/household used by the
# Playwright suite (e2e/). Not the same as your own dev account - the suite
# creates and deletes real rows against whatever Supabase project
# NEXT_PUBLIC_SUPABASE_URL points at, so keep this pointed at an account you
# don't mind the tests writing to.
#
# Copy to .env.test (gitignored) and fill in real values.
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=
