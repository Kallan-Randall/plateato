# Copy this file to ".env" and fill in your Supabase project values.
# Both values are safe to expose in client code (the publishable/anon key is public by design).
# Find them in your Supabase project: Settings -> API.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
